# Server-only default credential for Docker Compose or `npm run dev`.
# Copy to .env in the repository root; do not commit the populated file.
INFERENCE_LENS_API_KEY=
INFERENCE_LENS_API_ENDPOINT=https://api.openai.com/v1

# Optional: the model the server-default profile starts on. Setting the
# endpoint alone is enough for a provider that needs no key, such as a local
# llama.cpp server; leave the model unset and the profile starts with none,
# so the model picker fills it from whatever the provider actually serves.
INFERENCE_LENS_MODEL=

# Optional: DNS names this service may be reached under, comma-separated.
# Address literals and loopback names (127.0.0.1, 0.0.0.0, LAN addresses,
# localhost) are always served; any other name has to be listed here, which is
# what keeps a rebound DNS name from reaching the API. Only needed behind a
# reverse proxy or a real hostname.
INFERENCE_LENS_ALLOWED_HOSTS=

# Optional read-only n8n import connection. The base URL is the instance root
# (including an installation subpath), without /api/v1. Keep the API key
# server-only; it is never sent to the browser or stored in a project.
#
# From Docker Desktop, n8n running on the host is commonly reachable at
# http://host.docker.internal:5678. On Linux, use a shared Docker network,
# resolvable service name, or the configured host-gateway address.
INFERENCE_LENS_N8N_BASE_URL=
INFERENCE_LENS_N8N_API_KEY=
