{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trace Lens",
  "version": "0.1.0",
  "identifier": "app.tracelens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:3003",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trace Lens",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"]
  }
}
